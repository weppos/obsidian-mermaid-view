{
	"name": "obsidian-mermaid-view",
	"version": "0.5.0",
	"description": "Obsidian plugin for viewing Mermaid files in views.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"mermaid",
		"diagram"
	],
	"author": {
		"name": "Simone Carletti",
		"url": "https://simonecarletti.com"
	},
	"license": "MIT",
	"dependencies": {
		"obsidian": "latest"
	},
	"devDependencies": {
		"@codemirror/commands": "^6.10.3",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.36.5",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.5.0",
		"eslint": "^10.0.0",
		"esbuild": "^0.27.4",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"globals": "^17.4.0",
		"jiti": "^2.6.1",
		"typescript": "^5.3.0",
		"typescript-eslint": "^8.58.0",
		"vitest": "^4.1.2"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"eslint": "$eslint",
			"@eslint/js": "$@eslint/js"
		}
	}
}
